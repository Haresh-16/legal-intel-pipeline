# Groq LLM (https://console.groq.com)
GROQ_API_KEY=

# The News API free tier (https://www.thenewsapi.com)
THE_NEWS_API_TOKEN=

# Google Sheets service account (https://console.cloud.google.com -> IAM -> Service Accounts)
# Share the target spreadsheet with this service account email as Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key field from the service account JSON key, keeping \n escapes literal.
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=
